# API 鉴权；留空表示不启用聊天接口鉴权
LB2A_API_KEY=

# 登录配置
LB2A_LOGIN_PORTAL=https://lobsterai.youdao.com

# Redis：auths 与 data 均存储于此
LB2A_REDIS_URL=redis://127.0.0.1:6379/0
LB2A_REDIS_PREFIX=lb2a

# 上游 API
LB2A_UPSTREAM_BASE=https://lobsterai-server.youdao.com
LB2A_TIMEOUT_SECONDS=180
LB2A_MAX_ACCOUNT_RETRIES=3

# 冷却策略：支持纯数字秒数或 60s、10m、12h、1d
LB2A_HARD_CREDIT=12h
LB2A_SOFT_RATE=60s
LB2A_ERR_THRESHOLD=3
LB2A_ERR_COOLDOWN=10m

# 本地进程内定时任务小时列表，使用 JSON 数组格式
# Vercel Cron 使用 UTC，默认 0 1,13 * * * 对应北京时间 09:00 与 21:00
LB2A_CHECKIN_HOURS=[9, 21]
LB2A_KEEPALIVE_HOURS=[22]
